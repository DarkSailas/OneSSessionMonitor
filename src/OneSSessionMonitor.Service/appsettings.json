{
  // ==============================================================================
  // КОНФИГУРАЦИЯ СЕРВИСА МОНИТОРИНГА СЕАНСОВ 1С (OneSSessionMonitor)
  // Протокол взаимодействия: 100% RAS / RAC (Remote Administration Server)
  // ==============================================================================
  "SessionMonitor": {
    // Адрес сервера администрирования 1С (RAS) в формате "хост:порт".
    // Пример: "srv-1c-app:1545" или "localhost:1545".
    "Server": "localhost:1545",

    // Полный путь к утилите rac.exe (если null — автопоиск в Program Files).
    "RacPath": null,

    // Имя и пароль администратора кластера 1С (null, если авторизация выключена).
    "ClusterAdminUser": null,
    "ClusterAdminPassword": null,

    // Адрес сервера защиты СЛК 3.0 / 2.0 (хост:порт).
    "SlkServerEndpoint": "localhost:9099",
    "SlkUser": null,
    "SlkPassword": null,

    // ------------------------------------------------------------------------------
    // КРИТЕРИИ СПЯЩИХ СЕАНСОВ (HIBERNATE)
    // ------------------------------------------------------------------------------
    "OnlyHibernate": true,
    "MinHibernateMinutes": 90,

    // ------------------------------------------------------------------------------
    // КРИТЕРИИ ЗАВИСШИХ СЕАНСОВ (FROZEN / DEADLOCKS)
    // ------------------------------------------------------------------------------
    "CleanFrozenSessions": true,
    "MaxDbProcMinutes": 40,
    "MaxCallDurationMinutes": 30,

    // ------------------------------------------------------------------------------
    // БЕЛЫЕ СПИСКИ ИСКЛЮЧЕНИЙ (НИКОГДА НЕ ЗАВЕРШАТЬ)
    // ------------------------------------------------------------------------------
    "ExcludedUsers": ["Administrator", "Администратор", "DefUser", "ServiceExchange", "ФоновыйОбмен"],
    "ExcludedInfoBases": [],
    "ExcludedAppIds": ["Designer"],
    "TargetAppIds": [],
    "InfoBasePattern": null,
    "UserNamePattern": null,

    // Интервал опроса для фоновой службы (в секундах)
    "IntervalSeconds": 60,
    "DryRun": false,

    // Параметры ротации и хранения логов
    "LogRetainedDays": 7,
    "LogMaxTotalSizeMb": 100,
    "LogLevel": "Error"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
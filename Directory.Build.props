<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_</PathMap>
    <!-- Выносим директории bin и obj за пределы Google Диска для исключения блокировок файлов -->
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\Temp\OneSSessionMonitorBuild\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\Temp\OneSSessionMonitorBuild\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <!-- Отключение сателлитных папок локализации -->
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <Version>1.4.0</Version>
    <FileVersion>1.4.0.0</FileVersion>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <Product>OneSSessionMonitor</Product>
    <Company>DarkSailas</Company>
    <NoWarn>$(NoWarn);NU1900;NU1901;NU1902;NU1903;NU1904;CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8632;CS1998</NoWarn>
  </PropertyGroup>
</Project>
